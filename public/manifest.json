{
  "manifest_version": 3,
  "name": "Claude Threads Kanban",
  "version": "0.1.0",
  "description": "Shows threads of a claude.ai project as a Kanban board. Unofficial; all data stays in your browser.",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
